#!/bin/sh

# Get the current branch name
branch=$(git rev-parse --abbrev-ref HEAD)

# Check if the branch is 'main'
if [ "$branch" = "main" ]; then
  echo "🔴  STOP! Direct pushes to 'main' are FORBIDDEN."
  echo "👉  You must create a feature branch (e.g., feature/menu-ui) and use a Pull Request."
  exit 1
fi